{
  "entities": {
    "PlayerProfileCloud": {
      "description": "Cloud synchronized player profile",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 28 },
        "countryCode": { "type": "string", "maxLength": 2 },
        "avatar": { "type": "string" },
        "language": { "type": "string" },
        "bestGameScore": { "type": "integer" },
        "totalScore": { "type": "integer" },
        "weeklyScore": { "type": "integer" },
        "weekKey": { "type": "string" },
        "diasporaScore": { "type": "integer" },
        "bestDiasporaScore": { "type": "integer" },
        "streak": { "type": "integer" },
        "bestStreak": { "type": "integer" },
        "lastDailyDate": { "type": "string" },
        "gamesPlayed": { "type": "integer" },
        "gamesWon": { "type": "integer" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "DuelRoom": {
      "description": "Real-time duel room state",
      "properties": {
        "roomCode": { "type": "string", "maxLength": 12 },
        "hostUid": { "type": "string", "maxLength": 128 },
        "hostName": { "type": "string", "maxLength": 28 },
        "hostCountryCode": { "type": "string", "maxLength": 2 },
        "hostAvatar": { "type": "string" },
        "guestUid": { "type": "string", "maxLength": 128 },
        "guestName": { "type": "string", "maxLength": 28 },
        "guestCountryCode": { "type": "string", "maxLength": 2 },
        "guestAvatar": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "status": { "type": "string" },
        "hostScore": { "type": "integer" },
        "guestScore": { "type": "integer" },
        "winnerUid": { "type": "string", "maxLength": 128 },
        "isDraw": { "type": "boolean" },
        "serverProof": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "DuelParticipantDoc": {
      "description": "Participant record in duel room",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "role": { "type": "string" },
        "name": { "type": "string", "maxLength": 28 },
        "countryCode": { "type": "string", "maxLength": 2 },
        "avatar": { "type": "string" },
        "joinedAt": { "type": "timestamp" }
      }
    },
    "DuelChatMessage": {
      "description": "Live chat message in duel room",
      "properties": {
        "roomCode": { "type": "string", "maxLength": 12 },
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 28 },
        "senderAvatar": { "type": "string" },
        "senderCountryCode": { "type": "string", "maxLength": 2 },
        "kind": { "type": "string" },
        "text": { "type": "string", "maxLength": 280 },
        "createdAt": { "type": "timestamp" }
      }
    }
  },
  "firestore": {
    "paths": {
      "/players/{uid}": {
        "entity": "PlayerProfileCloud",
        "description": "Player profile document keyed by auth uid"
      },
      "/duels/{roomCode}": {
        "entity": "DuelRoom",
        "description": "Duel room document keyed by room code"
      },
      "/duels/{roomCode}/participants/{uid}": {
        "entity": "DuelParticipantDoc",
        "description": "Participants subcollection"
      },
      "/duels/{roomCode}/messages/{messageId}": {
        "entity": "DuelChatMessage",
        "description": "Live chat messages subcollection"
      }
    }
  }
}
